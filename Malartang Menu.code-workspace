{
  "folders": [
    {
      "name": "Malartang Menu Website",
      "path": "."
    }
  ],
  "settings": {
    "files.associations": {
      "*.html": "html",
      "*.css": "css",
      "*.js": "javascript"
    },
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "index.html": "styles.css, app.js, favicon.svg"
    }
  },
  "extensions": {
    "recommendations": [
      "ritwickdey.LiveServer",
      "esbenp.prettier-vscode"
    ]
  }
}
